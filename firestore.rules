rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Só usuários cadastrados (login por nickname ou CPF) leem e gravam.
    function editor() {
      return request.auth != null
        && request.auth.token.email in ['ciceroav@scoutpro.app', 'phsouzaleao@scoutpro.app', 'teste@scoutpro.app'];
    }
    match /scoutpro_dados/{area} { allow read, write: if editor(); }
    match /{document=**} { allow read, write: if false; }
  }
}
